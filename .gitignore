# ============================================================
# Dataset files
# ============================================================

# Ignore downloaded MovieLens-1M data, but retain documentation.
data/raw/*
!data/raw/README
!data/raw/ml-1m/
data/raw/ml-1m/*
!data/raw/ml-1m/README

# Ignore generated intermediate and processed artifacts.
data/interim/*
!data/interim/README.md
!data/interim/ml-1m/
data/interim/ml-1m/*
!data/interim/ml-1m/README.md

data/processed/*
!data/processed/README.md
!data/processed/ml-1m/
data/processed/ml-1m/*
!data/processed/ml-1m/README.md

# Common generated dataset formats
*.parquet
*.feather
*.arrow


# ============================================================
# Model checkpoints
# ============================================================

# Large trained model files
*.pt
*.pth
*.ckpt
*.safetensors

# Retain checkpoint documentation
!checkpoints/README.md


# ============================================================
# Experiment outputs
# ============================================================

# Temporary or verbose logs
*.log
logs/
results/logs/
results/tmp/
results/**/tensorboard/
results/**/wandb/

# Temporary files
*.tmp
*.temp
*.bak

# Keep useful research artifacts such as:
# training_history.csv
# run_summary.json
# test_results.json
# These are intentionally NOT ignored.


